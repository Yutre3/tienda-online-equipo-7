# SQLite funciona de inmediato y conserva los datos en un archivo portátil.
DB_ENGINE=sqlite
SQLITE_PATH=datos/tienda_online.db

# Para usar MySQL cambie DB_ENGINE=mysql y configure los valores siguientes.
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=tienda_online
DB_USER=tienda_app
DB_PASSWORD=CAMBIAR_CLAVE_ANTES_DE_USAR
