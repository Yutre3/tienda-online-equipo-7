{
  "python.defaultInterpreterPath": "${workspaceFolder}/.venv",
  "python.terminal.activateEnvironment": true,
  "python.testing.pytestEnabled": true,
  "python.testing.unittestEnabled": false,
  "python.testing.pytestArgs": ["tests"],
  "files.exclude": {
    ".venv": true,
    ".pytest_cache": true,
    "**/__pycache__": true,
    "**/*.pyc": true
  },
  "sqltools.connections": [
    {
      "name": "Tienda Online (SQLite portátil)",
      "driver": "SQLite",
      "database": "${workspaceFolder}/datos/tienda_online.db",
      "previewLimit": 50
    },
    {
      "name": "Tienda Online (MySQL/XAMPP)",
      "driver": "MySQL",
      "server": "127.0.0.1",
      "port": 3306,
      "database": "tienda_online",
      "username": "tienda_app",
      "askForPassword": true,
      "previewLimit": 50
    }
  ]
}
