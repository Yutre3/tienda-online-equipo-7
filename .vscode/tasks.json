{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "1. Instalar dependencias",
      "type": "shell",
      "command": "python",
      "args": ["-m", "pip", "install", "-r", "requirements.txt"],
      "problemMatcher": []
    },
    {
      "label": "2. Crear base de datos",
      "type": "shell",
      "command": "python",
      "args": ["-m", "scripts.crear_base_datos"],
      "problemMatcher": []
    },
    {
      "label": "3. Verificar sistema",
      "type": "shell",
      "command": "python",
      "args": ["-m", "scripts.verificar_sistema"],
      "problemMatcher": []
    },
    {
      "label": "4. Ejecutar pruebas",
      "type": "shell",
      "command": "python",
      "args": ["-m", "unittest", "discover", "-s", "tests", "-v"],
      "group": {"kind": "test", "isDefault": true},
      "problemMatcher": []
    },
    {
      "label": "5. Ejecutar tienda",
      "type": "shell",
      "command": "python",
      "args": ["app.py"],
      "group": {"kind": "build", "isDefault": true},
      "problemMatcher": []
    },
    {
      "label": "Preparar proyecto completo",
      "dependsOrder": "sequence",
      "dependsOn": [
        "1. Instalar dependencias",
        "2. Crear base de datos",
        "3. Verificar sistema"
      ],
      "problemMatcher": []
    }
  ]
}
